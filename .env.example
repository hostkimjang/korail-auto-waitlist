# 이 파일을 .env로 복사한 뒤 빈 값을 채우세요. .env는 Git과 Docker build context에서 제외됩니다.
# 실제 비밀값을 따옴표 없이 쓰는 것을 권장합니다. 값에 $, #, 공백이 있으면 작은따옴표로 감싸세요.
# 공통 무작위 값 한 개 생성(Linux Bash, 48 bytes → 64자 Base64): openssl rand -base64 48
# Windows PowerShell 5.1/7은 호환되는 인스턴스 방식과 다섯 값 일괄 생성 절차를 docs/GETTING_STARTED.md에서 확인하세요.

COMPOSE_PROJECT_NAME=rail-waitlist
# 좌석 감시에 필요한 KORAIL·SRT sidecar와 experimental worker를 기본 구성에 포함합니다.
COMPOSE_PROFILES=experimental-rail
TZ=Asia/Seoul

# Android 공식 앱 인계 네 경로의 안전 기본값은 모두 꺼져 있습니다. 전체 QA용 예시는 README와 Android 인계 QA 문서를 따릅니다.
# 최신 코레일+에서 각 BROWSABLE 경로와 목적 화면을 확인한 빌드만 경로별로 true로 둡니다.
# PWA는 설치 앱 버전을 조회할 수 없으므로 검증한 Google Play 앱 버전도 각각 기록해야 활성화됩니다.
VITE_KORAIL_BOOKING_DEEPLINK_ENABLED=false
VITE_KORAIL_BOOKING_VALIDATED_VERSION=
VITE_KORAIL_TICKET_DEEPLINK_ENABLED=false
VITE_KORAIL_TICKET_VALIDATED_VERSION=
# 최신 SRT에서 srapp://main BROWSABLE 경로와 목적 화면을 확인한 빌드만 경로별로 true로 둡니다.
# ticket 경로는 고정 문자열 extra btnNo=2만 전달하며 미설치 fallback은 공식 발권·취소 조회 웹입니다.
VITE_SRT_MAIN_DEEPLINK_ENABLED=false
VITE_SRT_MAIN_VALIDATED_VERSION=
VITE_SRT_TICKET_DEEPLINK_ENABLED=false
VITE_SRT_TICKET_VALIDATED_VERSION=

# ── 필수 비밀값 ──────────────────────────────────────────────────────────────
# PostgreSQL 비밀번호. 새 설치에는 위 명령으로 만든 48바이트 무작위 Base64를 권장하며, 기존 DB 볼륨은 기존 값을 유지합니다.
POSTGRES_PASSWORD=
# 알림 채널·외부 credential 암호화 키. UTF-8 기준 32바이트 이상 무작위 값이며 분실 시 DB의 암호문을 복구할 수 없습니다.
SECRET_ENCRYPTION_KEY=
# 관리자 세션 서명 키. SECRET_ENCRYPTION_KEY와 다른 UTF-8 기준 32바이트 이상 무작위 값을 사용합니다.
AUTH_SESSION_SECRET=
# 최초 관리자 등록을 진행하는 동안에만 true. 기본 loopback/Tailscale에서 계정 생성 후 false로 바꾸고 재시작합니다.
AUTH_INITIAL_REGISTRATION_ENABLED=false

# ── 공식 시간표·좌석 감시·Web Push ──────────────────────────────────────────
# 공공데이터포털에서 발급받은 TAGO 일반 인증키(Decoding). 미사용 시 비워둘 수 있습니다.
TAGO_SERVICE_KEY=
# SRT 비회원 시간표 조회에서 일반실·특실 상태를 보강합니다. 예약·로그인은 하지 않습니다.
SRT_SEAT_STATUS_ENABLED=true
# SRT 계정 없는 좌석 관측을 background worker 감시에 사용합니다. 위 값과
# EXPERIMENTAL_RAIL_ENABLED도 모두 true여야 합니다.
SRT_SEAT_MONITORING_ENABLED=true
# 좌석 발견 뒤 저장된 SRT 계정으로 결제 직전 임시 예약을 정확히 한 번만 시도합니다.
# 자동 결제는 하지 않으며, 설정 화면에서 SRT 계정이 활성화되어 있어야 합니다.
SRT_RESERVATION_ONCE_ENABLED=false
# 동일 구간·날짜·시간창의 좌석 조회를 재사용할 시간(초). 1~300 범위입니다.
SRT_SEAT_STATUS_CACHE_TTL_SECONDS=1
# SRT 좌석 조회 한 번의 제한 시간(초). 3~30 범위입니다.
SRT_SEAT_STATUS_TIMEOUT_SECONDS=8
# SRT 계정 없는 조회 actor와 인증 session을 한 프로세스에서 소유하는 내부 sidecar입니다.
# URL은 Compose의 고정 내부 origin이며 변경할 수 없습니다.
SRT_PROVIDER_ADAPTER_ENABLED=true
# 활성화된 API·worker와 sidecar 사이에서 필수인 UTF-8 기준 32바이트 이상 무작위 값입니다. 로그·화면에 노출하지 않습니다.
SRT_PROVIDER_ADAPTER_TOKEN=
# API·worker가 sidecar 응답 전체를 기다리는 제한시간(초). 3~120 범위입니다.
SRT_PROVIDER_ADAPTER_TIMEOUT_SECONDS=30
# 사용자가 공식 KORAIL 결과 화면에서 명시적으로 가져온 2분 snapshot만 허용합니다.
KORAIL_BROWSER_BRIDGE_ENABLED=true
# 서버 관리 Chromium으로 KORAIL 공식 화면을 1회 조작·판독하는 실험 기능입니다.
# 아래 두 값과 KORAIL_SEAT_MONITORING_ENABLED를 모두 true로 지정하고 experimental-rail
# 프로필로 실행할 때 활성화됩니다. 값이 누락되면 런타임은 fail-closed합니다.
EXPERIMENTAL_RAIL_ENABLED=true
KORAIL_BROWSER_ADAPTER_ENABLED=true
# 서버 Chromium 엔진입니다. 실제 성공 PoC 경로인 pydoll이 기본이며,
# 기존 직접 실행·CDP 연결 경로로 되돌릴 때만 playwright_direct_cdp를 지정합니다.
KORAIL_BROWSER_ENGINE=pydoll
# 기본 true는 Chrome을 내부 Xvfb의 non-headless 모드로 실행합니다. OCI ARM64 실제 읽기
# 조회에서 확인한 경로이며 원격 화면 포트를 열지는 않습니다. false는 운영사별 별도 검증 뒤에만 사용하세요.
KORAIL_BROWSER_GUI_ENABLED=true
# noVNC는 compose.korail-gui.yml에서만 호스트 loopback에 노출합니다.
# 고정 호스트 포트는 1~65535를 사용하며 0은 임의 포트를 할당합니다.
# 화면 크기는 WIDTHxHEIGHT 픽셀 형식이며 시작 시 Xvfb가 검증합니다.
# 사용 절차: apps/api/KORAIL_BROWSER_DIAGNOSTICS.md
KORAIL_NOVNC_PORT=6080
KORAIL_VNC_GEOMETRY=1440x1000
# 서버 Chromium 결과를 반복 background 감시에 연결합니다. 위 두 값도 모두 true여야 하며
# 보호 응답 시 Redis cooldown 동안 요청을 중단합니다.
KORAIL_SEAT_MONITORING_ENABLED=true
# 좌석 발견 뒤 저장된 KORAIL 계정으로 결제 직전 임시 예약을 정확히 한 번만 시도합니다.
# 자동 결제는 하지 않으며, 설정 화면에서 KORAIL 계정이 활성화되어 있어야 합니다.
KORAIL_RESERVATION_ONCE_ENABLED=false
# 활성화된 sidecar와 API 사이에서 필수인 UTF-8 기준 32바이트 이상 무작위 값입니다.
KORAIL_BROWSER_ADAPTER_TOKEN=
# 동일 구간 결과의 메모리 cache는 1~300초입니다.
KORAIL_BROWSER_ADAPTER_CACHE_TTL_SECONDS=1
# API가 sidecar 완료를 기다리는 전체 제한시간은 30~180초입니다.
KORAIL_BROWSER_ADAPTER_TIMEOUT_SECONDS=90
# 브라우저 내부 개별 UI 대기 제한시간은 5~60초입니다. 전체 제한시간보다 짧게 설정하세요.
KORAIL_BROWSER_ACTION_TIMEOUT_SECONDS=25
# Pydoll의 첫 정상 조회는 공식 화면이 만든 same-origin POST template과 쿠키를 sidecar 메모리에만
# 넘기고 Chromium을 닫습니다. 같은 구간에서는 검증된 날짜·출발시각 필드만 바꿔 재조회하며,
# 최대 수명(30~1800초) 또는 검색 횟수(2~100)에 도달하면 다음 조회를 cold init부터 시작합니다.
# 원문 URL·body·header·cookie는 파일·DB·로그에 저장하지 않습니다.
KORAIL_BROWSER_SESSION_REUSE_TTL_SECONDS=1800
KORAIL_BROWSER_SESSION_REUSE_MAX_SEARCHES=100
# 429처럼 호출 제한이 확인됐을 때 같은 운영사 조회를 멈출 시간(초). 60~86400 범위입니다.
SEAT_STATUS_RATE_LIMIT_COOLDOWN_SECONDS=300
# 보호·비정상 접근 응답이 확인됐을 때 같은 운영사 조회를 멈출 시간(초). 60~86400 범위입니다.
SEAT_STATUS_PROTECTION_COOLDOWN_SECONDS=60
# API·worker·scheduler·실험 worker·KORAIL browser sidecar의 파일 로그 회전 설정입니다.
# 파일당 크기는 65536~104857600바이트, backup 개수는 1~20입니다.
# 현재 파일 1개와 backup 4개를 합쳐 기본 최대 약 25 MiB를 사용합니다.
APP_LOG_MAX_BYTES=5242880
APP_LOG_BACKUP_COUNT=4
APP_LOG_LEVEL=INFO
# Web Push 미사용 시 두 키는 비워 둘 수 있습니다. 사용 시 아래 Docker 명령 결과의 같은 키 쌍을 입력합니다.
# docker run --rm node:22-alpine npx --yes web-push generate-vapid-keys --json
# private key는 비밀이며 기존 구독을 유지하려면 업데이트 때 키 쌍을 재생성하지 않습니다.
# SUBJECT는 mailto:실제주소 또는 HTTPS 연락처입니다. 아래 example.invalid는 사용 전에 바꿉니다.
# 설정·교체·HTTPS 조건은 docs/GETTING_STARTED.md의 "Web Push를 사용할 때"를 따릅니다.
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:admin@example.invalid

# ── 선택 프로필 ──────────────────────────────────────────────────────────────
# monitoring profile 사용 전 필수. 32자 이상 무작위 값을 권장합니다.
GRAFANA_ADMIN_PASSWORD=
# `age-keygen`이 출력하는 한 줄짜리 AGE-SECRET-KEY-1... 값. restore profile에서만 사용합니다.
BACKUP_AGE_IDENTITY=
# 위 identity와 짝인 age1... 공개 수신자 키. backup profile에서 사용합니다.
BACKUP_AGE_RECIPIENT=
# backup 프로필의 보관 일수와 실행 간격(초)입니다. 각각 양의 정수 사용을 권장합니다.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# ── 네트워크·관리자 인증 ─────────────────────────────────────────────────────
# Caddy: 로컬/Tailscale 접속은 :80, 공개 도메인은 실제 FQDN을 지정합니다.
SITE_ADDRESS=:80
WEB_UPSTREAM=web:8080
API_UPSTREAM=api:8000
# 기본은 host loopback에만 bind하여 LAN 평문 HTTP 노출을 막습니다.
CADDY_HTTP_BIND=127.0.0.1:80
CADDY_HTTPS_BIND=127.0.0.1:443

POSTGRES_DB=rail_waitlist
POSTGRES_USER=rail_waitlist

# 관리자 등록·로그인·상태 변경을 허용할 브라우저 origin입니다. 포트까지 정확히 적습니다.
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1,http://localhost:4173,http://localhost
CORS_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1,http://localhost:4173,http://localhost
# 공개/Tailscale HTTPS에서는 true. 순수 HTTP localhost 통합 시험에서만 false입니다.
AUTH_COOKIE_SECURE=false

# 공개 도메인 예시:
# SITE_ADDRESS=rail.example.com
# CADDY_HTTP_BIND=0.0.0.0:80
# CADDY_HTTPS_BIND=0.0.0.0:443
# AUTH_ALLOWED_ORIGINS=https://rail.example.com
# CORS_ORIGINS=https://rail.example.com
# AUTH_COOKIE_SECURE=true
