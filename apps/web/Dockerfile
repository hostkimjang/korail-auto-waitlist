FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_KORAIL_BOOKING_DEEPLINK_ENABLED=false
ARG VITE_KORAIL_BOOKING_VALIDATED_VERSION=
ARG VITE_KORAIL_TICKET_DEEPLINK_ENABLED=false
ARG VITE_KORAIL_TICKET_VALIDATED_VERSION=
ARG VITE_SRT_MAIN_DEEPLINK_ENABLED=false
ARG VITE_SRT_MAIN_VALIDATED_VERSION=
ARG VITE_SRT_TICKET_DEEPLINK_ENABLED=false
ARG VITE_SRT_TICKET_VALIDATED_VERSION=
ENV VITE_KORAIL_BOOKING_DEEPLINK_ENABLED=${VITE_KORAIL_BOOKING_DEEPLINK_ENABLED}
ENV VITE_KORAIL_BOOKING_VALIDATED_VERSION=${VITE_KORAIL_BOOKING_VALIDATED_VERSION}
ENV VITE_KORAIL_TICKET_DEEPLINK_ENABLED=${VITE_KORAIL_TICKET_DEEPLINK_ENABLED}
ENV VITE_KORAIL_TICKET_VALIDATED_VERSION=${VITE_KORAIL_TICKET_VALIDATED_VERSION}
ENV VITE_SRT_MAIN_DEEPLINK_ENABLED=${VITE_SRT_MAIN_DEEPLINK_ENABLED}
ENV VITE_SRT_MAIN_VALIDATED_VERSION=${VITE_SRT_MAIN_VALIDATED_VERSION}
ENV VITE_SRT_TICKET_DEEPLINK_ENABLED=${VITE_SRT_TICKET_DEEPLINK_ENABLED}
ENV VITE_SRT_TICKET_VALIDATED_VERSION=${VITE_SRT_TICKET_VALIDATED_VERSION}
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist/client /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
USER nginx
CMD ["nginx", "-g", "daemon off;"]
